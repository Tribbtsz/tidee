{
  "name": "tidee",
  "displayName": "tidee",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "AI-assisted Microsoft Edge favorites organizer",
  "license": "MIT",
  "scripts": {
    "dev": "wxt -b edge",
    "dev:chrome": "wxt -b chrome",
    "build": "wxt build -b edge",
    "build:chrome": "wxt build -b chrome",
    "zip": "wxt zip -b edge",
    "compile": "vue-tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@lucide/vue": "^1.59.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@wxt-dev/module-vue": "^1.0.3",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wxt": "^0.21.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
